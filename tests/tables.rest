### get all records from table
GET  {{server}}/steps
Content-Type: application/json
Authorization: Bearer {{token}}

### select specific record by id
GET {{server}}/steps/75
Content-Type: application/json
Authorization: Bearer {{token}}

### Get records by field
GET {{server}}/steps/user_id/52
Content-Type: application/json
Authorization: Bearer {{token}}

### Get records by field and operator
GET {{server}}/steps/step_count/gt/5000
Content-Type: application/json
Authorization: Bearer {{token}}

### add a new record
POST {{server}}/steps
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "user_id":54,
    "step_count":6000,
    "date":"2026-10-12"
}

###update spec rec by id
PATCH {{server}}/steps/75
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "step_count":100
}
###update records by field and operator
PATCH {{server}}/steps/step_count/lt/10000
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "step_count":9999
}

###delete all records from a table
DELETE {{server}}/steps
Content-Type: application/json
Authorization: Bearer {{token}}

###delete a specific record by ID
DELETE {{server}}/steps/3
Content-Type: application/json
Authorization: Bearer {{token}}

###Delete records by field
DELETE {{server}}/steps/user_id/3
Content-Type: application/json
Authorization: Bearer {{token}}

###Delete records by field and operator
DELETE {{server}}/steps/step_count/lt/3000
Content-Type: application/json
Authorization: Bearer {{token}}