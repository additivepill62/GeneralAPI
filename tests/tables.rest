@host = http://localhost:
@port = 4444
@server={{host}}:{{port}}
### get all records from table
GET  {{server}}/steps
Content-Type: application/json

### select spec record by id
GET {{server}}/steps/75
Content-Type: application/json

### Get records by field
GET {{server}}/steps/user_id/52
Content-Type: application/json

### Get records by field and operator
GET {{server}}/steps/step_count/gt/5000
Content-Type: application/json
### add a new record
POST {{server}}/steps
Content-Type: application/json

{
    "user_id":54,
    "step_count":6000,
    "date":"2026-10-12"
}

